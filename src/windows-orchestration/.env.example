"""
Environment configuration for Windows Orchestration Service.
Copy to .env and update with actual values.

Canonical defaults are defined in config_defaults.py.
Update that file when changing a default — do not change values here alone.
"""

# Foundry Local Service
FOUNDRY_LOCAL_HOST=http://localhost:5000
FOUNDRY_API_TIMEOUT=10.0

# Orchestration Service
SERVICE_TIMEOUT=15.0
FLASK_ENV=production
FLASK_DEBUG=False

# Logging
LOG_LEVEL=DEBUG

# Misty controller — Misty-side recording behavior during laptop mic conversations
# - fallback (safe default): full Misty-side recording kept as fallback audio.
# - tally: short recording pulse for tally light only; no fallback audio.
# - off: do not start Misty-side recording.
LAPTOP_MISTY_RECORDING_MODE=fallback
# Duration of the tally-light-only recording pulse when LAPTOP_MISTY_RECORDING_MODE=tally.
LAPTOP_MISTY_TALLY_RECORDING_S=1.0

# Misty controller timing
RECORDING_DURATION_S=6.0
FOLLOWUP_LISTEN_S=5.0
FOLLOWUP_TIMEOUT_S=90.0
FOLLOWUP_MAX_TURNS=12
IDLE_TIMEOUT_S=900.0
PROACTIVE_REBOOT_AFTER_CYCLES=5
PROACTIVE_REBOOT_AFTER_RECORDINGS=15

# Model IDs (locked for v1)
# Chat: phi-3.5-mini
# STT: whisper-tiny
# TTS: kokoro-v0_19

# TTS configuration
# Kokoro voice (default: af_sky). See kokoro-onnx docs for available voices.
# KOKORO_VOICE=af_sky
# Kokoro synthesis speed multiplier (default: 1.2). Higher = faster but may reduce quality.
KOKORO_SPEED=1.2
# Maximum TTS audio cache entries (default: 200). Pinned (pre-warmed) entries are never evicted.
TTS_CACHE_MAX=200

# Prompt length limits (latency control)
# Maximum characters for a single user prompt — longer inputs are truncated before LLM inference.
# Reducing this value lowers input token count and can significantly improve latency.
MAX_USER_CHARS=400

# Maximum total characters across all messages (system prompt + conversation history) sent to
# the LLM in a single request. Oldest turns are trimmed first; the system prompt and the most
# recent user message are always preserved. Set to 0 to disable.
MAX_CONTEXT_CHARS=5000

# System prompt override — if unset, the default Misty persona prompt is used.
# The default already includes summarization and brevity instructions.
# SYSTEM_PROMPT=

# Face Recognition (#16)
# Enable face recognition during conversations (requires trained faces on Misty).
# When enabled, Misty's camera identifies the speaker and personalizes LLM responses.
USE_FACE_RECOGNITION=false
# Timeout in seconds for face recognition attempt during each conversation turn.
FACE_RECOGNITION_TIMEOUT_S=3.0
